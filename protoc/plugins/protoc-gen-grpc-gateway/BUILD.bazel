alias(
    name = "protoc-gen-grpc-gateway",
    actual = "@protoc_gen_grpc_gateway//:protoc-gen-grpc-gateway",
)

bzl_library(
    name = "registry_bzl",
    srcs = ["registry.bzl"],
)
