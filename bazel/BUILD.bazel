load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

# Prebuilt GitHub release; select is the exec platform (host that runs the tool).
alias(
    name = "buildifier",
    actual = select(
        {
            "@bazel_utils_core//:linux_amd64": "@buildifier_linux_amd64//file",
            "@bazel_utils_core//:linux_arm64": "@buildifier_linux_arm64//file",
            "@bazel_utils_core//:darwin_amd64": "@buildifier_darwin_amd64//file",
            "@bazel_utils_core//:darwin_arm64": "@buildifier_darwin_arm64//file",
            "@bazel_utils_core//:windows_amd64": "@buildifier_windows_amd64//file",
            "@bazel_utils_core//:windows_arm64": "@buildifier_windows_arm64//file",
        },
        no_match_error = "No prebuilt buildifier for this OS/CPU",
    ),
)

bzl_library(
    name = "buildifier_bzl",
    srcs = ["buildifier.bzl"],
    deps = [
        "@bazel_skylib//lib:shell",
        "@bazel_utils_core//internal:workspace_tool",
    ],
)

bzl_library(
    name = "bazel",
    srcs = ["bazel.bzl"],
    deps = [":buildifier_bzl"],
)
