load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

# buildifier from this module's go.mod (gazelle-generated binary in go_deps).
alias(
    name = "buildifier",
    actual = "@com_github_bazelbuild_buildtools//buildifier:buildifier",
)

bzl_library(
    name = "buildifier_bzl",
    srcs = ["buildifier.bzl"],
    deps = ["//internal:workspace_tool"],
)
