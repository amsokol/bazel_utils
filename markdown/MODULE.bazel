"""markdownlint-cli2 from this module's pnpm lock."""

module(
    name = "bazel_utils_md",
    version = "0.2.8",
)

bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "bazel_utils_core", version = "0.2.8")
bazel_dep(name = "rules_nodejs", version = "6.7.5")

# Latest Node in rules_nodejs 6.7.5's catalog (24.19.0 is not listed yet).
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.18.0")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(pnpm_version = "11.20.0")
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")
