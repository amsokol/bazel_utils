"""Buf CLI, generate/lint/format, and local codegen plugins."""

module(
    name = "bazel_utils_buf",
    version = "0.1.1",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "bazel_utils_core", version = "0.1.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "35.1")
bazel_dep(name = "rules_rust", version = "0.73.0")

include("//:plugins.MODULE.bazel")

# Fallback when this module is root (plugin repin). The consumer's
# buf.toolchains(version) wins and is what gets downloaded.
buf = use_extension("//:extensions.bzl", "buf")
buf.toolchains(version = "v1.72.0")
use_repo(buf, "buf", "buf_plugins")
