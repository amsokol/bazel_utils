load("//:plugin.bzl", "buf_plugin")
load("//:protoc_prefix.bzl", "protoc_prefix")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "Cargo.lock",
    "cargo-bazel-lock.json",
])

# protovalidate-buffa-protos build.rs finds WKTs at $PROTOC/../../include.
# protoc comes from protobuf's prebuilt toolchain, not @protobuf//:protoc.
protoc_prefix(
    name = "protoc_prefix",
    wkts = [
        "@protobuf//:descriptor_proto_srcs",
        "@protobuf//:well_known_type_protos",
    ],
)

# crate_universe rust_binary names end in __bin; buf_plugin keeps PATH names.
buf_plugin(
    name = "protoc-gen-protovalidate-buffa",
    actual = "@protoc_gen_protovalidate_buffa_v0_6_0//:protoc-gen-protovalidate-buffa__protoc-gen-protovalidate-buffa",
)
