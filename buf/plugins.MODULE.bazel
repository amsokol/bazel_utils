"""Rust toolchain and per-version local plugin crate hubs."""

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.97.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

include("//plugins/protoc-gen-protovalidate-buffa/v0.6.0:crates.MODULE.bazel")
# One include per plugins/<name>/<version>/crates.MODULE.bazel.
