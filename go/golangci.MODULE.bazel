http_archive(
    name = "golangci_lint_windows_arm64",
    build_file_content = _WIN_BUILD,
    sha256 = "947b9a5bf762d465710b376c156f0184abb2168378b0826af1899e0ee7183742",
    strip_prefix = "golangci-lint-{}-windows-arm64".format(_GOLANGCI),
    urls = [_GOLANGCI_URL.format(
        platform = "windows-arm64.zip",
