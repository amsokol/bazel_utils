"""Prebuilt golangci-lint (GitHub release). Fetched for the exec OS/CPU; not stored in git."""

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

_GOLANGCI = "2.12.2"

_GOLANGCI_URL = "https://github.com/golangci/golangci-lint/releases/download/v{version}/golangci-lint-{version}-{platform}"

_UNIX_BUILD = """exports_files(["golangci-lint"], visibility = ["//visibility:public"])"""

_WIN_BUILD = """exports_files(["golangci-lint.exe"], visibility = ["//visibility:public"])"""

http_archive(
    name = "golangci_lint_linux_amd64",
    build_file_content = _UNIX_BUILD,
    sha256 = "8df580d2670fed8fa984aac0507099af8df275e665215f5c7a2ae3943893a553",
    strip_prefix = "golangci-lint-{}-linux-amd64".format(_GOLANGCI),
    urls = [_GOLANGCI_URL.format(
        platform = "linux-amd64.tar.gz",
        version = _GOLANGCI,
    )],
)

http_archive(
    name = "golangci_lint_linux_arm64",
    build_file_content = _UNIX_BUILD,
    sha256 = "44cd40a8c76c86755375adfeea52cfd3533cb43d7bd647771e0ae065e166df3a",
    strip_prefix = "golangci-lint-{}-linux-arm64".format(_GOLANGCI),
    urls = [_GOLANGCI_URL.format(
        platform = "linux-arm64.tar.gz",
        version = _GOLANGCI,
    )],
)

http_archive(
    name = "golangci_lint_darwin_amd64",
    build_file_content = _UNIX_BUILD,
    sha256 = "f6f06d94b6241521c53d15450c5209b028270bf966f842afb11c030c79f5bc16",
    strip_prefix = "golangci-lint-{}-darwin-amd64".format(_GOLANGCI),
    urls = [_GOLANGCI_URL.format(
        platform = "darwin-amd64.tar.gz",
        version = _GOLANGCI,
    )],
)

http_archive(
    name = "golangci_lint_darwin_arm64",
    build_file_content = _UNIX_BUILD,
    sha256 = "a9c54498731b3128f79e090be6110f3e5fffccc617b08142ed244d4126c73f29",
    strip_prefix = "golangci-lint-{}-darwin-arm64".format(_GOLANGCI),
    urls = [_GOLANGCI_URL.format(
        platform = "darwin-arm64.tar.gz",
        version = _GOLANGCI,
    )],
)

http_archive(
    name = "golangci_lint_windows_amd64",
    build_file_content = _WIN_BUILD,
    sha256 = "bd42e3ebc8cb4ececb86941983baaf1dc221bbb04d838e94ce63b49cc91e02bb",
    strip_prefix = "golangci-lint-{}-windows-amd64".format(_GOLANGCI),
    urls = [_GOLANGCI_URL.format(
