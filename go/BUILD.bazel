load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

# golangci-lint from this module's go.mod (gazelle-generated binary in go_deps).
alias(
    name = "golangci-lint",
    actual = "@com_github_golangci_golangci_lint_v2//cmd/golangci-lint:golangci-lint",
)

# govulncheck from this module's go.mod (gazelle-generated binary in go_deps).
alias(
    name = "govulncheck",
    actual = "@org_golang_x_vuln//cmd/govulncheck:govulncheck",
)

bzl_library(
    name = "go_sdk_env",
    srcs = ["go_sdk_env.bzl"],
)

bzl_library(
    name = "dirs",
    srcs = ["dirs.bzl"],
)

bzl_library(
    name = "golangci",
    srcs = ["golangci.bzl"],
    deps = [
        ":dirs",
        "//internal:workspace_tool",
    ],
)

bzl_library(
    name = "govulncheck_bzl",
    srcs = ["govulncheck.bzl"],
    deps = [
        ":dirs",
        "//internal:workspace_tool",
    ],
)
