"""pip-audit from this module's uv.lock; prebuilt ruff from GitHub."""

module(
    name = "bazel_utils_python",
    version = "0.2.3",
)

bazel_dep(name = "aspect_rules_py", version = "1.11.7")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "bazel_utils_core", version = "0.2.3")
bazel_dep(name = "rules_python", version = "2.3.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.14")
python.toolchain(python_version = "3.14")

uv_bin = use_extension("@aspect_rules_py//uv/unstable:extension.bzl", "uv_bin")
uv_bin.toolchain()
use_repo(uv_bin, "uv")

uv = use_extension("@aspect_rules_py//uv/unstable:extension.bzl", "uv")
uv.declare_hub(
    hub_name = "bazel_utils_pypi",
)
uv.project(
    default_build_dependencies = [
        "setuptools",
        "build",
        "wheel",
    ],
    hub_name = "bazel_utils_pypi",
    lock = "//:uv.lock",
    pyproject = "//:pyproject.toml",
)
use_repo(uv, "bazel_utils_pypi")

include("//:ruff.MODULE.bazel")
