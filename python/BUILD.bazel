load("@aspect_rules_py//uv/unstable:defs.bzl", "py_console_script_binary")
load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//:ruff.bzl", "ruff_binary")

package(default_visibility = ["//visibility:public"])

exports_files([
    "pyproject.toml",
    "uv.lock",
])

ruff_binary(
    name = "ruff",
    pkg = "@bazel_utils_pypi//ruff",
)

# pip-audit from this module's uv.lock [dependency-groups] `dev`.
py_console_script_binary(
    name = "pip-audit",
    pkg = "@bazel_utils_pypi//pip_audit",
    venv = "dev",
    # Hub marker does not pull typing_extensions (cyclonedx-python-lib).
    deps = ["@bazel_utils_pypi//typing_extensions"],
)

bzl_library(
    name = "ruff_bzl",
    srcs = ["ruff.bzl"],
    deps = [
        "@bazel_lib//lib:copy_file",
        "@bazel_utils_core//internal:labels",
        "@bazel_utils_core//internal:workspace_tool",
    ],
)

bzl_library(
    name = "pip_audit_bzl",
    srcs = ["pip_audit.bzl"],
    deps = [
        "@bazel_skylib//lib:shell",
        "@bazel_utils_core//internal:workspace_tool",
    ],
)

bzl_library(
    name = "python",
    srcs = ["python.bzl"],
    deps = [
        ":pip_audit_bzl",
        ":ruff_bzl",
    ],
)
