"""Aggregator workspace for developing bazel_utils language modules."""

module(
    name = "bazel_utils",
    version = "0.2.8",
)

bazel_dep(name = "bazel_utils_bazel", version = "0.2.8")
bazel_dep(name = "bazel_utils_buf", version = "0.2.8")
bazel_dep(name = "bazel_utils_core", version = "0.2.8")
bazel_dep(name = "bazel_utils_go", version = "0.2.8")
bazel_dep(name = "bazel_utils_md", version = "0.2.8")
bazel_dep(name = "bazel_utils_protoc", version = "0.2.8")
bazel_dep(name = "bazel_utils_python", version = "0.2.8")
bazel_dep(name = "bazel_utils_rust", version = "0.2.8")

local_path_override(
    module_name = "bazel_utils_bazel",
    path = "bazel",
)

local_path_override(
    module_name = "bazel_utils_buf",
    path = "buf",
)

local_path_override(
    module_name = "bazel_utils_core",
    path = "core",
)

local_path_override(
    module_name = "bazel_utils_go",
    path = "go",
)

local_path_override(
    module_name = "bazel_utils_md",
    path = "markdown",
)

local_path_override(
    module_name = "bazel_utils_protoc",
    path = "protoc",
)

local_path_override(
    module_name = "bazel_utils_python",
    path = "python",
)

local_path_override(
    module_name = "bazel_utils_rust",
    path = "rust",
)

# Empty ROOT_PLUGIN_LABELS here: this aggregator has no protoc.plugin tags.
protoc = use_extension("@bazel_utils_protoc//:extensions.bzl", "protoc")
use_repo(protoc, "protoc_root_plugins")
