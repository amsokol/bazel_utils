load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:native_binary.bzl", "native_binary")

package(default_visibility = ["//visibility:public"])

# Prebuilt binary; select is the exec platform (host that runs the tool).
native_binary(
    name = "cargo-audit",
    src = select(
        {
            "@bazel_utils_core//:linux_amd64": "@cargo_audit_linux_amd64//:cargo-audit",
            "@bazel_utils_core//:linux_arm64": "@cargo_audit_linux_arm64//:cargo-audit",
            "@bazel_utils_core//:darwin_amd64": "@cargo_audit_darwin_amd64//:cargo-audit",
            "@bazel_utils_core//:darwin_arm64": "@cargo_audit_darwin_arm64//:cargo-audit",
            "@bazel_utils_core//:windows_amd64": "@cargo_audit_windows_amd64//:cargo-audit.exe",
            "@bazel_utils_core//:windows_arm64": "@cargo_audit_windows_arm64//:cargo-audit.exe",
        },
        no_match_error = "No prebuilt cargo-audit for this OS/CPU",
    ),
    out = "cargo-audit.bin",
)

bzl_library(
    name = "cargo_audit_bzl",
    srcs = ["cargo_audit.bzl"],
    deps = [
        "@bazel_skylib//lib:shell",
        "@bazel_utils_core//internal:workspace_tool",
    ],
)

bzl_library(
    name = "rust",
    srcs = ["rust.bzl"],
    deps = [":cargo_audit_bzl"],
)
