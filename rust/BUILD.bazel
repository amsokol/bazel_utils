load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.lock",
    "Cargo.toml",
])

# cargo-audit from this module's Cargo.lock (crate_universe binary).
alias(
    name = "cargo-audit",
    actual = "@bazel_utils_cargo//:cargo-audit__cargo-audit",
)

bzl_library(
    name = "cargo_audit_bzl",
    srcs = ["cargo_audit.bzl"],
    deps = [
        "@bazel_skylib//lib:shell",
        "@bazel_utils_core//internal:workspace_tool",
    ],
)

bzl_library(
    name = "rust",
    srcs = ["rust.bzl"],
    deps = [":cargo_audit_bzl"],
)
