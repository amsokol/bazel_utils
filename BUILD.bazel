load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@npm//:defs.bzl", "npm_link_all_packages")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

bzl_library(
    name = "go",
    srcs = ["go.bzl"],
    deps = [
        "//go:golangci",
        "//go:govulncheck_bzl",
    ],
)

bzl_library(
    name = "bazel",
    srcs = ["bazel.bzl"],
    deps = ["//bazel:buildifier_bzl"],
)

bzl_library(
    name = "python",
    srcs = ["python.bzl"],
    deps = ["//python:ruff_bzl"],
)

bzl_library(
    name = "markdown",
    srcs = ["markdown.bzl"],
    deps = ["//markdown:markdown"],
)
