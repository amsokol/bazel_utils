load("@bazel_utils_bazel//:bazel.bzl", "buildifier_format", "buildifier_test")
load("@bazel_utils_md//:markdown.bzl", "markdownlint_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    ".markdownlint-cli2.yaml",
    "MODULE.bazel",
])

buildifier_test(
    name = "lint",
    size = "small",
)

buildifier_format(
    name = "format",
)

markdownlint_test(
    name = "markdown",
    size = "small",
)

test_suite(
    name = "core_tests",
    tests = [
        "@bazel_utils_core//internal:workspace_file_label_test",
        "@bazel_utils_core//internal:workspace_rel_dir_test",
    ],
)

filegroup(
    name = "protoc_plugins",
    srcs = [
        "@bazel_utils_buf//protoc/plugins/protoc-gen-buffa",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-buffa-packaging",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-connect-go",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-connect-rust",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-go",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-grpc-gateway",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-openapiv2",
        "@bazel_utils_buf//protoc/plugins/protoc-gen-protovalidate-buffa",
    ],
)
